
{
    "manifest_version": 3,
    "name": "Attendance Predictor",
    "version": "1.0",
    "description": "Predict your attendance and remaining bunk allowance.",

    "permissions": [
        "activeTab"
    ],

    "host_permissions": [
        "https://erp.vce.ac.in/*"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": [
                "https://erp.vce.ac.in/*"
            ],
            "js": [
                "content.js"
            ]
        }
    ]
}
